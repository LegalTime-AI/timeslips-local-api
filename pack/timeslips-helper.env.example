# Optional. The packed exe finds MAIN.FDB on first launch and writes
# %LOCALAPPDATA%\TimeslipsHelper\timeslips-helper.env itself.
# TIMESLIPS_FDB=C:\path\to\MAIN_COPY.FDB
TIMESLIPS_TOKEN=
# First launch turns sharing on. Set 0 to keep the helper on this PC only.
# TIMESLIPS_LAN=0
# TIMESLIPS_NO_UPDATE=1
# Headless smoke tests only. Leave unset so the packed exe stays in the tray.
# TIMESLIPS_NO_TRAY=1
